# NeuroTutor scheduled jobs.
# Server timezone is UTC; user is Moscow (MSK = UTC+3). Times below are UTC,
# with the Moscow equivalent in the comment.

# Morning drill: recall (spaced repetition) + proactive scenarios
# (cases, emergencies, intraop crises, operative steps).  07:00 MSK
# Batch is 1 recall + case + 1 scenario (~3): sized to the real answering
# pace — a 6-question backlog used to stall the loop for days.
0 4 * * * cd /root/neurotutor && venv/bin/python tg_handler.py --drill 1 >> data/cron.log 2>&1

# Evening reminder about unanswered drill questions (silent if none). 19:00 MSK
0 16 * * * cd /root/neurotutor && venv/bin/python tg_handler.py --remind >> data/cron.log 2>&1

# Re-grade backstop: grade answers that were deferred when MiniMax was
# overloaded (529), then deliver the feedback. Every 20 min; silent if none.
*/20 * * * * cd /root/neurotutor && venv/bin/python tg_handler.py --regrade >> data/cron.log 2>&1

# PubMed digest: recent operative-neurosurgery papers, last 14 days.  07:05 MSK
5 4 * * * cd /root/neurotutor && venv/bin/python tg_handler.py --digest 14 >> data/cron.log 2>&1

# Weekly competency report (gaps, weak spots, trend).  Sunday 19:00 MSK
0 16 * * 0 cd /root/neurotutor && venv/bin/python tg_handler.py --report >> data/cron.log 2>&1

# Evening report prompt: ask the user for a free-form day recap, which
# tg_handler._handle_evening_report parses into daily_logs.  22:00 MSK
0 19 * * * /bin/bash -c 'set -a; source /root/neurotutor/.env; set +a; curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" -d "chat_id=5939020075" -d "text=🗣 Вечерний отчёт. Скажи голосовым свободным рассказом: что сделал, где застрял, план на завтра, энергия X/10 — запишу в daily_logs. Триггеры: сделал сегодня / дневной отчёт / /day" -d "parse_mode=HTML" >/dev/null 2>&1'

# Dashboard snapshot backstop: grading already refreshes study.json after every
# answer; this hourly run guarantees the Live-maps dashboard still updates if the
# static dir was unmounted during a grade, and seeds it on first deploy. Silent
# no-op if the dashboard dir isn't present on this host.
0 * * * * cd /root/neurotutor && venv/bin/python -m neurotutor.dashboard.snapshot >> data/cron.log 2>&1
